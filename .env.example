# These belong to the community user's own installation. Never paste into chat.
# Export variables in your terminal/service. This file is a template, NOT loaded automatically.
VSO_PUBLIC_URL=http://127.0.0.1:8787
VSO_PORT=8787
# VSO_DATA_DIR=/absolute/private/path/vegas-social-os
# VSO_CHROME=/absolute/path/to/google-chrome
# Hosted agent-first: agent injects these through runtime secrets, never user code.
VSO_STATE_BACKEND=sqlite
VSO_REMOTE_BROWSER=0
VSO_RUNTIME_PERSISTENT=0
VSO_INSTALLATION_ID=
SUPABASE_SERVER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Set the currently supported Meta version from the developer dashboard.
META_GRAPH_VERSION=
# Optional secret-free state backup (not the production job backend in this alpha).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_USER_JWT=

# Optional legacy environment configuration; prefer encrypted dashboard Connections.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=

# Optional read-only Higgsfield catalog. No automatic CLI install or paid rendering.
VSO_HIGGSFIELD_ENABLED=0
VSO_HIGGSFIELD_BIN=higgsfield

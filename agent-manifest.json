{
  "name": "vegas-social-os",
  "version": "0.7.1",
  "entrypoint": "BOOTSTRAP.md",
  "agent_setup_script": "scripts/bootstrap-ubuntu.sh",
  "runtime": {
    "recommended": "independent-vps",
    "recommended_installer": "scripts/bootstrap-ubuntu.sh",
    "preinstalled_dependencies_installer": "scripts/install-vps.sh",
    "setup_link": "scripts/new-setup-link.sh",
    "optional_managed_recipe": "deploy/render.yaml",
    "cloud_managed_not_required": true,
    "local_pc_required": false,
    "user_managed_vps_supported": true,
    "requirements": [
      "Ubuntu 24.04 / Debian 12+ x86_64 (Python 3.11+)",
      "persistent server disk",
      "HTTPS domain with 80/443 accessible",
      "Chrome/Chromium",
      "Node 22+",
      "Python 3.11+",
      "FFmpeg",
      "Xvfb/noVNC"
    ],
    "aws_recipe": "deploy/aws/instance.json",
    "aws_agent_guide": "docs/AWS-ONBOARDING.md",
    "flow_engine_installer": "scripts/install-flow-engine.sh",
    "flow_engine_lock": "deploy/flow-engine/lock.json",
    "flow_execution": "complete pinned engine, attach-only for native profiles; imported engines retain ownership"
  },
  "database": {
    "provider": "SQLite",
    "mode": "local authoritative private state",
    "default": true,
    "path": "/var/lib/vegas-social-os",
    "optional_managed_provider": "Supabase",
    "optional_managed_schema": "supabase/agent-state.sql"
  },
  "plugin": {
    "manifest": "plugin.json",
    "master_skill": "skills/vegas-social-master/SKILL.md",
    "remote_endpoint": "/mcp",
    "primary_host": "ChatGPT web Work",
    "requires_local_executor": false,
    "web_guide": "docs/CHATGPT-WEB.md"
  },
  "image_policy": {
    "provider": "chatgpt-native-only",
    "fallback": "none",
    "missing_tool": "block image stage"
  },
  "user_interface": {
    "onboarding": "/onboarding",
    "dashboard": "/dashboard",
    "account_signin": "official OAuth or private isolated Flow browser",
    "provider_configuration": "private dashboard /api/config, encrypted server-side",
    "purpose": "onboarding and storyboard/clip/release review; ChatGPT is the workstation"
  },
  "capabilities": [
    "source_read",
    "repository_write",
    "supabase_manage",
    "persistent_runtime",
    "persistent_volume",
    "https_route",
    "secret_write",
    "process_exec",
    "plugin_create",
    "plugin_install",
    "native_images",
    "native_asset_transfer",
    "provider_app_manage",
    "host_scheduler",
    "managed_app_host",
    "drive_write",
    "vps_manage"
  ],
  "secrets": [
    "VSO_INSTALLATION_ID",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "INSTAGRAM_CLIENT_ID",
    "INSTAGRAM_CLIENT_SECRET",
    "META_GRAPH_VERSION",
    "VSO_VAULT_KEY",
    "FACEBOOK_CLIENT_ID",
    "FACEBOOK_CLIENT_SECRET",
    "FACEBOOK_CONFIG_ID (optional)"
  ],
  "user_commands_required": "only if no connected remote setup agent is available",
  "paid_provisioning": "no required additional paid SaaS; user's VPS/network/provider credits may cost",
  "completion": "VPS health + isolated browser + persistent SQLite + account-specific login verified; live Flow generation/publishing is separate",
  "media": {
    "archive": "Google Drive when explicitly authorized",
    "working_storage": "private VPS /var/lib/vegas-social-os/media",
    "existing_host_connection": "verify write/upload capabilities; backend uses separate OAuth consent",
    "ingestion": "host fileParams or resumable raw-byte PUT, checksummed and decoded"
  },
  "optional_secrets": [
    "SUPABASE_URL",
    "SUPABASE_SERVER_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "INSTAGRAM_CLIENT_ID",
    "INSTAGRAM_CLIENT_SECRET",
    "META_GRAPH_VERSION"
  ],
  "community": {
    "installation_scope": "single operator per independent instance",
    "multi_tenant_saas": false,
    "maintainer_credentials_included": false,
    "provider_login_requires_user_consent": true,
    "social_oauth_apps_requires_registration": true,
    "flow_generation_live_verified": false,
    "publishing_live_verified": false
  },
  "optional_managed_setup_script": "scripts/agent_bootstrap.py",
  "product_contract": "docs/CHATGPT-FIRST.md",
  "new_user_journey": "docs/NEW-USER-JOURNEY.md",
  "automation": {
    "host_events_implemented": true,
    "feedback_queue_implemented": true,
    "automatic_release_policy_implemented": false,
    "contract": "docs/CHATGPT-FIRST.md",
    "host_continuation_verified": false
  },
  "administration": {
    "implemented": true,
    "broker": "local root-owned Unix socket",
    "gateway_user": "vegas-social",
    "scope": "vps:admin",
    "dangerous_operation_approval": "private owner TOTP, exact request, 120 seconds"
  }
}
